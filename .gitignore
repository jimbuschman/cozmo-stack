/cozmo-stack/src/Cozmo.Robot/Vision/Data/marker_nn_library.bin

# Large derived symbol dumps regenerate with re-analysis/tools/*.py
/re-analysis/symbols/exports_mangled.txt
/re-analysis/symbols/exports_demangled.txt
/re-analysis/symbols/rodata_strings.txt
/re-analysis/symbols/objects_vtables_typeinfo.txt

