#!/bin/sh
# Push gate for main: a push to main is refused unless the fidelity check and the full test suite pass on
# exactly the commit being pushed. Enable it once per clone:
#     git config core.hooksPath scripts/hooks
# Pushes that change no code and no fidelity records (config, scripts, agent files, docs, reports) skip the
# test suite, and so does a push whose code and records already passed the suite in this clone (a retry after a
# rebase onto other windows' status files). Never bypass this with --no-verify.

zero=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1
# Only code and the fidelity records need the test suite; config, scripts, agent files and docs push at once.
needs_tests='^(cozmo-stack/|re-analysis/fidelity_manifest\.json|re-analysis/FIDELITY_GAPS\.md|re-analysis/inventory/|re-analysis/tools/)'

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$remote_ref" = "refs/heads/main" ] || continue
    [ "$local_sha" = "$zero" ] && continue          # a delete, not a push of commits

    # origin/main moved since the last fetch: the push would be rejected anyway, so don't run the suite first.
    if [ "$remote_sha" != "$zero" ] && ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        echo "pre-push: REFUSED. origin/main has new commits. Run: git pull --rebase, then push again."
        exit 1
    fi
    if [ "$remote_sha" = "$zero" ]; then base=$(git rev-parse --verify -q origin/main || echo ""); else base=$remote_sha; fi
    if [ -n "$base" ]; then changed=$(git diff --name-only "$base" "$local_sha"); else changed=$(git ls-tree -r --name-only "$local_sha"); fi

    if [ -n "$changed" ] && ! echo "$changed" | grep -Eq "$needs_tests"; then
        echo "pre-push: no code or fidelity records changed; the test suite is skipped."
        continue
    fi

    if [ "$(git rev-parse HEAD)" != "$local_sha" ]; then
        echo "pre-push: REFUSED. Check out the commit you are pushing ($local_sha) so it can be tested."
        exit 1
    fi
    if ! git diff --quiet HEAD -- || [ -n "$(git ls-files --others --exclude-standard -- cozmo-stack)" ]; then
        echo "pre-push: REFUSED. The working tree has uncommitted or untracked changes under cozmo-stack, so the"
        echo "tests would not test what you are pushing. Commit or move them first."
        exit 1
    fi

    mkdir -p .scratch
    log=.scratch/pre-push.log
    if ! python re-analysis/tools/fidelity.py --check > "$log" 2>&1; then
        tail -20 "$log"; echo "pre-push: REFUSED. fidelity.py --check failed."; exit 1
    fi

    # The suite's result depends only on the code and the fidelity records. If this clone has already passed it on
    # byte-identical content (the usual case after a push is refused because another window pushed a status file or
    # a report, and this one was rebased onto it), the result can't differ, so it isn't run again.
    . scripts/hooks/gate-key.sh
    key=$(gate_key "$local_sha")   # scripts/test-full.sh records the same fingerprint
    passed=.scratch/pre-push-passed
    if [ -f "$passed" ] && grep -qx "$key" "$passed"; then
        echo "pre-push: this code and these records already passed the full suite in this clone; it is not run again."
        continue
    fi

    # Records-only push (operator, 2026-10-12): when nothing under cozmo-stack/ or re-analysis/tools/ changed, only
    # the manifest, FIDELITY_GAPS.md or the inventory did. The code is then the code an earlier full suite passed, so
    # only the test classes that read those files run. Their result is not cached as a full pass.
    if ! echo "$changed" | grep -Eq '^(cozmo-stack/|re-analysis/tools/)'; then
        records_tests='FullyQualifiedName~FidelityManifestTests|FullyQualifiedName~HardwareCatalogFidelityTests|FullyQualifiedName~ControlCheckFidelityTests|FullyQualifiedName~LinkCheckFidelityTests|FullyQualifiedName~M3M4HwTests|FullyQualifiedName~M5AnimationTests|FullyQualifiedName~EngineAppLayerTests|FullyQualifiedName~M4ControlTests|FullyQualifiedName~M3DeviceTests|FullyQualifiedName~M2ProtocolTests|FullyQualifiedName~WwiseVoiceLinkerTests'
        echo "pre-push: fidelity check passed; records only, so the manifest-reading test classes run for $local_sha; log in $log"
        if ! dotnet test cozmo-stack/Cozmo.sln --filter "$records_tests" >> "$log" 2>&1; then
            grep -E "\[FAIL\]|Failed!|error CS" "$log" | head -20
            echo "pre-push: REFUSED. The manifest-reading tests failed."
            exit 1
        fi
        grep -E "Passed!" "$log" | tail -1
        echo "pre-push: gate passed (records only)."
        continue
    fi

    # Harness-only push (operator, 2026-10-20): no stack project references Cozmo.Conformance (only the test project
    # does), so a push whose code changes are only the harness and the test files that use it runs just those test
    # classes. Any other code or record change still runs the full suite. Not cached as a full pass.
    harness_tests=$(grep -l "using Cozmo.Conformance" cozmo-stack/tests/Cozmo.Protocol.Tests/*.cs | sed 's#.*/##; s#\.cs$##')
    harness_files=$(echo "$harness_tests" | sed 's#^#cozmo-stack/tests/Cozmo.Protocol.Tests/#; s#$#.cs#')
    other=$(echo "$changed" | grep -E "$needs_tests" | grep -v '^cozmo-stack/src/Cozmo\.Conformance/' | grep -vxF "$harness_files")
    if [ -n "$harness_tests" ] && [ -z "$other" ]; then
        filter=$(echo "$harness_tests" | sed 's#^#FullyQualifiedName~#' | paste -sd'|' -)
        echo "pre-push: fidelity check passed; harness only, so the harness test classes run for $local_sha; log in $log"
        if ! dotnet test cozmo-stack/Cozmo.sln --filter "$filter" --blame-hang --blame-hang-timeout 5m >> "$log" 2>&1; then
            grep -E "\[FAIL\]|Failed!|error CS|hang|Blame" "$log" | head -20
            echo "pre-push: REFUSED. The harness tests failed."
            exit 1
        fi
        grep -E "Passed!" "$log" | tail -1
        echo "pre-push: gate passed (harness only)."
        continue
    fi

    echo "pre-push: fidelity check passed; full test suite for $local_sha (about 4 minutes); log in $log"
    # A test that hangs or allocates without end fails the push after 5 minutes and is named in the log, instead of
    # stalling the machine (seen twice on 2026-10-12, with 6-10 GB in testhost).
    if ! dotnet test cozmo-stack/Cozmo.sln --blame-hang --blame-hang-timeout 5m >> "$log" 2>&1; then
        grep -E "\[FAIL\]|Failed!|error CS|hang|Blame|active test" "$log" | head -20
        echo "pre-push: REFUSED. The full test suite failed."
        exit 1
    fi
    grep -E "Passed!" "$log" | tail -1
    echo "$key" >> "$passed"
    echo "pre-push: gate passed."
done
exit 0
