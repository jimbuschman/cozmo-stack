<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The embedded ARM emulator (Emulation/UnicornLongjmp.cs) reproduces only VCRUNTIME longjmp's non-CET path: no CET shadow stacks. -->
    <CETCompat>false</CETCompat>
    <RootNamespace>Cozmo.Conformance</RootNamespace>
    <AssemblyName>cozmo-conformance</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Cozmo.Protocol\Cozmo.Protocol.csproj" />
    <ProjectReference Include="..\Cozmo.Transport\Cozmo.Transport.csproj" />
    <ProjectReference Include="..\Cozmo.Robot\Cozmo.Robot.csproj" />
  </ItemGroup>
</Project>
