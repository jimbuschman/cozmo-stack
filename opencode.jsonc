{
  "$schema": "https://opencode.ai/config.json",
  // The default model for every session and runner in this repo. ":floor" makes OpenRouter itself send each
  // request to the cheapest provider serving the model, whatever routing options reach it.
  "model": "openrouter/deepseek/deepseek-v4.1-flash:floor",
  // Project-local permissions, in the V1 "permission" form so the opencode CLI (V1) used by the job runners accepts
  // it; the V2 "permissions" rule list is rejected by V1. Everything is allowed so unattended runs never stop to ask.
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow"
  },

  // OpenRouter routing for DeepSeek V4.1 Flash: the cheapest provider first, falling back to the next cheapest.
  // Parasail charged about 5x InferenceNet for the same model (2026-09-27), so it is never used.
  "provider": {
    "openrouter": {
      "models": {
        "deepseek/deepseek-v4.1-flash:floor": {
          "name": "DeepSeek V4.1 Flash (cheapest provider)"
        },
        "deepseek/deepseek-v4.1-flash": {
          "options": {
            "provider": {
              "sort": "price",
              "ignore": ["Parasail"],
              "allow_fallbacks": true
            }
          }
        }
      }
    }
  }
}
